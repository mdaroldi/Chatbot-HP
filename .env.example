# Copy to .env and adjust. Never commit .env.
# Values below are placeholders or safe local defaults.

# --- Docker Compose: published ports
# Interface the API and frontend ports bind to. Keep 127.0.0.1 on a laptop; on a
# remote VM set 0.0.0.0 to reach them from outside (and firewall them).
BIND_ADDRESS=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501

# --- Application
APP_ENV=development
LOG_LEVEL=INFO
# Include exception messages in logs (they may contain user text). Local debugging
# only; rejected when APP_ENV=production.
LOG_INCLUDE_EXCEPTION_MESSAGES=false
# Comma-separated list of allowed browser origins. "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:8501
# Serve /docs, /redoc and /openapi.json. Set to false to hide them.
API_DOCS_ENABLED=true

# --- PostgreSQL (also read by the postgres container)
# HOST and PORT apply only when running the API outside Compose; inside Compose the
# backend always uses postgres:5432.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hpdocs
POSTGRES_USER=hpdocs
# Required. Change it for anything other than local development.
POSTGRES_PASSWORD=change-me-local-only
# Connection pool per API process: at most POOL_SIZE + MAX_OVERFLOW connections.
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# --- Qdrant (outside Compose only; inside Compose the backend uses http://qdrant:6333)
QDRANT_URL=http://qdrant:6333
# Alias that always names the live chunk collection (each build gets its own).
QDRANT_COLLECTION_ALIAS=hpdocs_chunks
# Keep the previous build's collection after a swap, for rollback (true or false).
# Older builds are always deleted.
INDEX_KEEP_PREVIOUS=true

# --- Health
READINESS_TIMEOUT_SECONDS=2.0

# --- Corpus (ingestion)
# Cache for the verified source PDFs; a valid cached file is reused without network.
CORPUS_DIR=corpus
# Largest accepted PDF, in bytes (the larger manual is about 16 MB).
CORPUS_MAX_BYTES=33554432
# Per-phase HTTP timeout and total deadline for one download, in seconds.
CORPUS_DOWNLOAD_TIMEOUT_SECONDS=120

# --- Embeddings (ingestion; local fastembed models on CPU)
# Dense model; its tokenizer also measures chunk size (chunks stay under 512 tokens).
EMBEDDING_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
# Cache for the downloaded models; a cached model is reused without network.
EMBEDDING_CACHE_DIR=models
# Texts per embedding batch; lower it if ingestion runs out of memory.
EMBEDDING_BATCH_SIZE=32
# BM25 average document length for the stored sparse vectors: a number, or `auto` for
# the mean length of the chunks being built (107.26 for chunking v2). 256 is
# fastembed's default. A change rebuilds the index on the next `up` (ADR 0009).
EMBEDDING_BM25_AVG_LEN=256

# Chunking v1 (ADR 0005). Largest chunk in dense-model tokens, prefix included;
# bge-small reads at most 512.
CHUNK_MAX_TOKENS=450
# Sections below this many tokens merge with the next one under the same parent.
CHUNK_MIN_TOKENS=65

# --- Retrieval (Phase 2; ADR 0009). Defaults change only by the benchmark's selection rule.
# dense, sparse or hybrid (dense and BM25 fused with reciprocal rank fusion).
RETRIEVAL_MODE=hybrid
RETRIEVAL_RERANK_ENABLED=true
# Chunks returned per question, out of the candidates the reranker scores.
RETRIEVAL_TOP_K=5
RETRIEVAL_RERANK_CANDIDATES=20
# Candidates per vector before fusion; at least RETRIEVAL_RERANK_CANDIDATES.
RETRIEVAL_PREFETCH_DENSE_LIMIT=20
RETRIEVAL_PREFETCH_SPARSE_LIMIT=20
# RRF constant k (60 as in the original paper; Qdrant's own default is 2).
RETRIEVAL_RRF_K=60
# Search one manual only when the question names its product (ENVY or OMEN).
RETRIEVAL_PRODUCT_FILTER_ENABLED=false
# Lowest top reranker score that counts as relevant, calibrated on the dev split for
# Xenova/ms-marco-MiniLM-L-6-v2 (ADR 0009). It belongs to that model and revision:
# recalibrate with `make eval-retrieval` when RERANKER_MODEL changes.
RETRIEVAL_RELEVANCE_THRESHOLD=-6.54
# Text put before the question for the dense query only (e.g. the BGE instruction).
RETRIEVAL_DENSE_QUERY_PREFIX=
# Cross-encoder reranker (pinned in backend/models.toml).
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Inference threads for requests, and ONNX threads per model call. Keep workers times
# threads within the container's CPUs.
INFERENCE_WORKERS=2
INFERENCE_ONNX_THREADS=2
QDRANT_SEARCH_TIMEOUT_SECONDS=2.0
# Longest accepted question, in characters.
QUERY_MAX_CHARS=1000
# POST /v1/search debug endpoint. Rejected when APP_ENV=production.
SEARCH_ENDPOINT_ENABLED=false
