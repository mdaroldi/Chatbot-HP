# Load profile (Phase 6, ADR 0013), read after .env by the Makefile's load targets.
# Load-profile knobs only: no secret (the key and the Postgres password stay in .env)
# and no setting that can change an answer. Unit tests pin both rules.

# Production behaviour: the stub ignores its test directives; INFO logs as deployed.
APP_ENV=production
LOG_LEVEL=INFO
# Profile A. `make load-up LOAD_PROVIDER=anthropic` overrides this for Profile B.
LLM_PROVIDER=stub
# 19 stub pieces x 160 ms ~ 3.0 s: the real answer's time from retrieval to the end of
# the stream (Phase 5 p50: 980 ms to the first token + 2,000 ms of streaming), so each
# stream holds its connection as long as a real one. Profile A's TTFT therefore
# excludes the provider's first-token latency.
LLM_STUB_TOKEN_DELAY_MS=160
# Profile B: one provider call is one attempt, so the harness's spend guard (hpdocs_load.budget)
# counts every attempt; a provider 429 or 5xx shows as an error, not a hidden retry.
LLM_MAX_RETRIES=0
# Out of the way for capacity runs: any 429 there counts as an error. The rate-limits-on
# run uses the defaults instead.
RATE_LIMIT_CONVERSATIONS_PER_MINUTE=10000
RATE_LIMIT_CONVERSATIONS_BURST=10000
RATE_LIMIT_SEARCH_PER_MINUTE=10000
RATE_LIMIT_SEARCH_BURST=10000
RATE_LIMIT_MESSAGES_PER_MINUTE=10000
RATE_LIMIT_MESSAGES_BURST=10000
# Its own port, so the load stack can run next to the dev stack.
API_PORT=8100
