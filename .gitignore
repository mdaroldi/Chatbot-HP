# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Secrets and local config
.env
.env.*
!.env.example

# Copyrighted source documents and local notes: never commit
*.pdf
job-description.txt

# Generated artifacts
# Corpus cache (CORPUS_DIR=corpus, relative to where ingestion runs)
/corpus/
/backend/corpus/
# Anchored (a bare `models/` also matched backend/tests/models/): only the places where
# runs create them. EMBEDDING_CACHE_DIR=models is relative to where ingestion runs.
/data/
/backend/data/
/models/
/backend/models/
/.cache/
/backend/.cache/
loadtest/results/
# Chunk review from `make inspect-chunks`: holds document text, never commit it
/ingest-review/
eval/reports/runs/

# OS and editors
.DS_Store
.idea/
.vscode/
